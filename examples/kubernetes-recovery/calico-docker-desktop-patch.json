{
  "spec": {
    "template": {
      "spec": {
        "containers": [
          {
            "name": "calico-node",
            "volumeMounts": [
              {
                "mountPath": "/sys/kernel/security",
                "$patch": "delete"
              }
            ]
          }
        ],
        "volumes": [
          {
